size = Vector3(0.7, 0.1, 0.36)

; 망토 꼬리 — 신설. 등에서 뒤아래로 40° 흘러내리는 삼각 자락.
; 위에서 내려다보는 이 게임에서 **앞뒤를 알려주는 가장 싼 장치**다(폴리곤 6개).
; ⚠ 처음엔 0.58×0.40 을 18° 로 눕혔더니 판의 뒷면이 카메라를 **정면으로 마주봐서**
;   등 전체를 덮는 검은 V 가 됐고 팀색(파란 로브)이 사라졌다. 좁히고 세웠다.
[sub_resource type="PrismMesh" id="mesh_tail"]
size = Vector3(0.36, 0.26, 0.09)

[sub_resource type="CapsuleMesh" id="mesh_arm"]
radius = 0.075
height = 0.4

[sub_resource type="SphereMesh" id="mesh_hand"]
radius = 0.095
height = 0.19

[sub_resource type="CapsuleMesh" id="mesh_leg"]
radius = 0.105
height = 0.46

[sub_resource type="BoxMesh" id="mesh_foot"]
size = Vector3(0.2, 0.1, 0.34)

; 부츠단 — 신설. 발목의 금색 링.
; 어두운 바지(0.17)와 더 어두운 신발(0.10)이 어두운 러그 위에서 붙어 보였다.
; 그 사이에 밝은 선을 하나 넣으면 **걸을 때 다리가 움직이는 게 보인다.**
[sub_resource type="CylinderMesh" id="mesh_cuff"]
top_radius = 0.112
bottom_radius = 0.124
height = 0.045

; 눈 — 반지름 0.085 → **0.145**, 그리고 얼굴 앞이 아니라 **머리 옆(±0.275)** 으로 옮겼다.
; 카멜레온 눈이 원래 머리 옆에 포탑처럼 달려 있다(기획서 10행 "멧챠 카멜레온풍").
; 실용적 이유가 더 크다 — 이 게임은 캐릭터가 **대부분 등을 보이고** 서 있어서
; 앞에 붙은 눈은 화면에 단 한 픽셀도 안 나왔다(렌더로 확인). 옆에 달면
; 머리 실루엣(폭 0.60) 밖으로 **0.12 씩** 튀어나와 **뒤에서도 두 개의 혹으로 읽힌다.**
[sub_resource type="SphereMesh" id="mesh_eye"]
radius = 0.145
height = 0.29

[sub_resource type="SphereMesh" id="mesh_pupil"]
radius = 0.066
height = 0.132

; 마법봉 막대 — 0.048 각 → 0.072 각, 길이 0.5 → 0.54. 상아색이라 어두운 마루에서 뜬다.
[sub_resource type="BoxMesh" id="mesh_wand"]
size = Vector3(0.072, 0.072, 0.54)

[sub_resource type="SphereMesh" id="mesh_wand_tip"]
radius = 0.125
height = 0.25

; 조준 레일 — 캐릭터 양옆으로 지나가는 두 줄. 가운데 한 줄로 안 그린 이유는
; 카메라가 -32° 고정이라 **북쪽(-Z)을 향하면 가운데 선이 캐릭터 몸에 통째로 가린다**.
; 그래서 (1) 몸통 좌우 바깥(±0.78m)에서 시작해 (2) 앞으로 7.5° 모이며
; (3) 촉이 머리 위로 넘어가는 4.5m 앞에 놓인다.
;   ⚠ 그 대가로 **정남향일 때 화살촉이 화면 아래(스킬바 뒤)로 빠진다.**
;     신경 쓰이면 개발이 `$Body/AimArrow.scale.z` 를 0.55~1.0 으로 줄이면 된다.
[sub_resource type="BoxMesh" id="mesh_aim_rail"]
size = Vector3(0.13, 0.02, 2.269)

; 화살촉 — 삼각기둥을 눕혔다. 꼭짓각 41° (폭 1.05 / 길이 1.4).
; 처음엔 폭 1.72 / 길이 0.95 로 잡았는데 꼭짓각이 84° 라 화살이 아니라 지붕으로 읽혔다.
[sub_resource type="PrismMesh" id="mesh_aim_head"]
size = Vector3(1.05, 1.4, 0.02)

; ══ 발사 이펙트 부품 (2026-08-02 신설) ═════════════════════════
; 개발이 코드로 켜고 끄는 **재료**다. 아트가 재질·그라디언트를 미리 구워 둔다.
; 설계 근거·수치·타이밍은 전부 `reports/designer.md` 「발사 손맛」 절에 있다.
;
; 🔑 목업을 실제로 렌더해서 얻은 결론 두 개(그대로 지킬 것):
;   1) **색은 「가산(add)」이 아니라 「혼합(mix)」에서만 살아남는다.**
;      → **유저가 그린 그림(=색의 주인)은 혼합. 플래시(=밝기 담당)만 가산.**
;   2) 가산 플래시의 한가운데는 어떤 색을 넣어도 흰색으로 탄다. 그러니 **일부러**
;      흰 코어를 따로 두되 **아주 짧게**(0.03초) 쓰고, 색 헤일로를 길게 남긴다.

; 부드러운 원형 감쇠. 플래시·후광·파티클이 전부 이 한 장을 쓴다.
[sub_resource type="Gradient" id="grad_soft"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="tex_soft"]
gradient = SubResource("grad_soft")
width = 128
height = 128
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="QuadMesh" id="mesh_fx_quad"]
size = Vector2(1, 1)

; 흰 코어 — 「터졌다」는 밝기만 담당한다. 색이 없다 = 어떤 스킬 색과도 안 싸운다.
[sub_resource type="StandardMaterial3D" id="mat_flash_core"]
transparency = 1
blend_mode = 1
shading_mode = 0
cull_mode = 2
billboard_mode = 1
billboard_keep_scale = true
albedo_color = Color(1, 1, 1, 0.95)
albedo_texture = SubResource("tex_soft")
render_priority = 1

; 색 헤일로 — 스킬 색으로 물들이는 자리(개발이 albedo_color 의 rgb 를 갈아끼운다).
[sub_resource type="StandardMaterial3D" id="mat_flash_halo"]
transparency = 1
