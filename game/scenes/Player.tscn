mesh = SubResource("mesh_aim_head")
surface_material_override/0 = SubResource("mat_aim_head")

; 카메라는 고정각(사용자 확정). 아래 각도는 Player.gd 의 cam_yaw_deg /
; cam_pitch_deg 값으로 _ready 에서 다시 세팅된다. 여기 값은 에디터 미리보기용.
