; 차징 등 — 「모으고 있다」를 방 전체에 알린다.
; 시전 진행률 t 에 대해 energy = 2.5·t² 로 올리면 **끝에서 확 밝아진다**(= 예고).
; 선형으로 올리면 언제 터질지 정보가 안 실린다. energy 0 = 잠든 상태.
; ⚠ `mat_wand_tip` 은 이 노드만 쓰는 독립 재질이다 — 개발이 `_reload_slot()` 에서
;    `albedo_color`/`emission` 을 슬롯 색으로 갈아끼워도 다른 데 안 번진다.
[node name="ChargeLight" type="OmniLight3D" parent="Body/Wand/Rod/Tip"]
light_color = Color(1, 0.72, 0.35, 1)
light_energy = 0.0
omni_range = 3.5

; Muzzle 은 Wand 의 **직계 자식**으로 남는다(경로 `$Body/Wand/Muzzle` 고정).
; 위치는 개정 전과 완전히 동일하다 — Body 기준 **(0.2652, 0.7492, -0.8974)**.
;   (Rod 의 basis × (0,0,-0.6) 을 손으로 푼 값. 아래 ⚠ 를 반드시 읽을 것)
; Player.gd 는 위치만 쓰고 방향은 Body 의 -Z 를 쓰므로 팔을 들어도 조준은 안 틀어진다.
;
; ⚠ **.tscn 의 Transform3D 12개 숫자는 basis 를 「행(row)」 순서로 적는다.**
;    즉 Transform3D(a0..a8, ox,oy,oz) 에서 실제 축(열벡터)은
;    X축=(a0,a3,a6) · Y축=(a1,a4,a7) · Z축=(a2,a5,a8) 이다.
;    (a0,a1,a2) 를 X축으로 읽으면 **전치된 행렬**이 되어 회전이 반대로 간다.
;    2026-08-01 이걸 렌더로 실측 확인했다 — 종전 리포트가 적어 둔
;    「Muzzle ≈ (0.50, 1.38, -0.90)」과 「마법봉이 위로 32°」는 열 기준으로 읽은
;    **오독**이다. 실제 마법봉은 앞아래 27° 를 향하고 봉 끝은 허리 높이(y≈0.82)다.
;    화면에서 머리 옆으로 보이는 것은 봉 끝이 0.78m 앞에 있어서 생기는 착시다.
[node name="Muzzle" type="Marker3D" parent="Body/Wand"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.0048, -0.3108, -0.8974)

; ── 총구 섬광 ──────────────────────────────────────────────────
; `visible = false` 로 잠들어 있다. 발사 프레임에 개발이 켜고 0.11초 뒤 끈다.
; Muzzle 의 자식이라 팔이 내리쳐진 자세 그대로, 마법봉 끝에서 터진다.
;
; 크기 근거(렌더 확인): 헤일로 quad 1.7m → 그라디언트 때문에 **눈에 보이는 지름은
; 약 0.85m** = 캐릭터 키(1.7m)의 절반. 7m 거리·FOV 70° 화면에서 확실히 읽히면서
; 캐릭터 얼굴은 안 가리는 크기다. 1.5m 로 줄였더니 손에 묻혀 안 보였다.
;
; 개발이 만질 것: `visible` · `scale` · 두 재질의 `albedo_color`
;   (Halo 의 rgb 만 스킬 색으로. Core 는 **흰색 그대로 둔다** — 위 ⚠ 참고)
[node name="Flash" type="Node3D" parent="Body/Wand/Muzzle"]
visible = false

[node name="Halo" type="MeshInstance3D" parent="Body/Wand/Muzzle/Flash"]
transform = Transform3D(1.7, 0, 0, 0, 1.7, 0, 0, 0, 1, 0, 0, 0)
mesh = SubResource("mesh_fx_quad")
surface_material_override/0 = SubResource("mat_flash_halo")

[node name="Core" type="MeshInstance3D" parent="Body/Wand/Muzzle/Flash"]
transform = Transform3D(0.62, 0, 0, 0, 0.62, 0, 0, 0, 1, 0, 0, 0)
mesh = SubResource("mesh_fx_quad")
surface_material_override/0 = SubResource("mat_flash_core")

; 발사 순간 **방이 반응하게** 만드는 등. 이 목록에서 가성비가 제일 좋다 —
; 폴리곤 0개로 바닥·가구·러그가 전부 스킬 색으로 물든다. 고정 카메라라 바닥이 늘 보인다.
; energy 0 으로 잠들어 있다. 개발이 **2.4 → 0 을 0.10초** `ease_out` 으로 감쇠시킨다.
;
; ⚠ **범위 5.0 / 세기 4.0 은 과했다(렌더 실측).** 반경 5m 짜리 따뜻한 웅덩이가 생겨
;   화면을 먹고, 무엇보다 **자기가 만든 빛이 자기 섬광(Flash quad)을 덮어서** 섬광이
;   흰 점으로 쪼그라들었다. 그래서 4.0m / 2.4 로 내렸다.
;   순서를 기억할 것 — **읽히는 건 quad 고, 등은 「방이 반응한다」만 담당한다.**
[node name="FireLight" type="OmniLight3D" parent="Body/Wand/Muzzle"]
light_color = Color(1, 0.72, 0.35, 1)
light_energy = 0.0
omni_range = 4.0

; 「기 모으기」 — 시전(차징) 동안 사방 0.75m 에서 마법봉 끝으로 **빨려 들어오는** 알갱이.
; radial_accel 이 음수라서 원점(= 총구)으로 가속한다. 0.75m 를 정확히 0.5초에 훑는다
; (s = ½·6.0·0.5² = 0.75). 발동 시간에 맞추려면 `lifetime` 만 바꾸고
; `radial_accel_*` 를 `-2·0.75/lifetime²` 로 같이 맞춰야 도착 시점이 안 어긋난다.
; `emitting` 은 false. 시전 시작에 켜고 발사 순간에 끈다.
[node name="ChargeMotes" type="CPUParticles3D" parent="Body/Wand/Muzzle"]
emitting = false
amount = 14
lifetime = 0.5
local_coords = true
mesh = SubResource("mesh_mote")
emission_shape = 2
emission_sphere_radius = 0.75
spread = 180.0
gravity = Vector3(0, 0, 0)
initial_velocity_min = 0.0
initial_velocity_max = 0.0
radial_accel_min = -6.0
radial_accel_max = -6.0

; ── 조준 방향 표시 ────────────────────────────────────────────
; 사용자 요구: "스킬이 날아가는 방향을 화살표나 이런 걸로 보이게".
; Body 밑에 달았다 → `_face()` 가 Body 를 돌리면 화살표가 **저절로** 따라 돈다.
; 즉 이건 언제나 `Player.aim_direction()` 과 정확히 같은 방향을 가리킨다.
; 개발이 코드로 할 것: 켜고 끄기(`$Body/AimArrow.visible`), 시전 중 색·굵기 강조,
; 덤블링 중 끄기(_tick_flip 이 Body.rotation.x 를 돌리면 화살표도 같이 돈다).
; 높이 0.03 — 러그 윗면(0.008)보다 위, 신발 밑창(0.015)보다 위라 어디서도 안 잠긴다.
[node name="AimArrow" type="Node3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.03, 0)

; 레일 두 줄 — 뒤(±0.78 @ z-0.35)에서 앞(±0.484 @ z-2.60)으로 7.5° 씩 모인다.
; 캐릭터를 감싸는 「깔때기」다. 화살촉(밑변 z-3.1)과는 **0.5m 를 일부러 띄웠다** —
; 붙여 놓으면 레일 바깥선과 촉 빗변이 한 줄로 이어져 화살이 아니라 **천막 실루엣**이 된다.
[node name="RailL" type="MeshInstance3D" parent="Body/AimArrow"]
