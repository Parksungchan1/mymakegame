; 스킬 크래프트 배틀 — Godot 4 프로토타입
; 3D 3인칭, 카메라 고정각. 이동 = 방향키, 점프 = 스페이스, 스킬 = QWER, 스킬창 = Tab.
; 총 게임이 아니다 — 조준(ADS)·스프린트는 넣지 않는다. 자세한 건 docs/게임기획.md.

config_version=5

[application]

config/name="SkillCraft Battle"
config/description="그림으로 스킬을 만드는 5v5 3D 대전 게임 — 프로토타입"
run/main_scene="res://scenes/Arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Balance="*res://scripts/skill/Balance.gd"
SkillDB="*res://scripts/skill/SkillDB.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[input]

; ── 이동: 방향키 전용 (WASD 는 QWER 스킬과 겹치므로 쓰지 않는다) ──
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
